{
  "opencollection": "1.0.0",
  "info": {
    "name": "UpLead Account Person API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Person",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search for a person by email, name+domain, or ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.uplead.com/v2/person-search",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query"
              },
              {
                "name": "email",
                "value": "",
                "type": "query"
              },
              {
                "name": "first_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "last_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "domain",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns enriched person/contact data. Provide email, or first_name+last_name+domain, or id."
        },
        {
          "info": {
            "name": "Search for a person (POST)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.uplead.com/v2/person-search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search for a person (POST)"
        }
      ]
    }
  ],
  "bundled": true
}